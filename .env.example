# Database
DATABASE_URL="postgresql://paan:paan_secret@localhost:5432/paan_ministries"

# Auth.js - Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here"
AUTH_URL="https://yourdomain.com"
AUTH_TRUST_HOST=true

# Email (SMTP — Proton Mail)
SMTP_HOST="smtp.protonmail.ch"
SMTP_PORT=587
SMTP_SECURE="false"
SMTP_USER="admin@paanministries.org"
SMTP_PASS="your-proton-smtp-token"
SMTP_FROM="PAAN Ministry <admin@paanministries.org>"

# Email (IMAP — Proton Mail Bridge or leave blank to disable inbox)
IMAP_HOST="127.0.0.1"

# App
NEXT_PUBLIC_APP_URL="https://yourdomain.com"
NEXT_PUBLIC_APP_NAME="PAAN MINISTRIES"
UPLOAD_DIR="./uploads"
MAX_UPLOAD_SIZE_MB=50
